{
  "project_name": "NETRA ERP - SOW Module",
  "design_philosophy": {
    "theme": "Enterprise Precision",
    "core_values": [
      "Clarity over decoration",
      "Density with breathability",
      "Action-oriented layouts"
    ],
    "aesthetic": "Zinc & White. High contrast text, subtle borders, no shadows unless for elevation (modals/popovers)."
  },
  "typography": {
    "font_family_primary": "Inter, sans-serif",
    "font_family_code": "JetBrains Mono, monospace",
    "scale": {
      "h1": "text-2xl font-semibold tracking-tight text-zinc-900",
      "h2": "text-lg font-medium tracking-tight text-zinc-900",
      "h3": "text-base font-medium text-zinc-900",
      "body": "text-sm text-zinc-600 leading-relaxed",
      "body_small": "text-xs text-zinc-500",
      "label": "text-[11px] uppercase tracking-wider font-semibold text-zinc-500",
      "metric": "text-2xl font-bold tracking-tight text-zinc-900"
    }
  },
  "colors": {
    "background": {
      "page": "bg-zinc-50/50",
      "card": "bg-white",
      "header": "bg-white/80 backdrop-blur-md border-b border-zinc-200"
    },
    "border": {
      "default": "border-zinc-200",
      "active": "border-zinc-400",
      "selected": "border-zinc-900"
    },
    "text": {
      "primary": "text-zinc-900",
      "secondary": "text-zinc-500",
      "tertiary": "text-zinc-400",
      "link": "text-zinc-900 hover:text-zinc-700 underline underline-offset-4 decoration-zinc-300"
    },
    "status": {
      "draft": {
        "bg": "bg-zinc-100",
        "text": "text-zinc-700",
        "border": "border-zinc-200"
      },
      "pending": {
        "bg": "bg-amber-50",
        "text": "text-amber-700",
        "border": "border-amber-200"
      },
      "approved": {
        "bg": "bg-emerald-50",
        "text": "text-emerald-700",
        "border": "border-emerald-200"
      },
      "rejected": {
        "bg": "bg-rose-50",
        "text": "text-rose-700",
        "border": "border-rose-200"
      }
    }
  },
  "layout_structure": {
    "page_container": "max-w-[1600px] mx-auto p-6 space-y-6",
    "header_grid": "grid grid-cols-1 md:grid-cols-4 gap-4",
    "main_content": "grid grid-cols-12 gap-6 h-[calc(100vh-200px)]",
    "sidebar": "col-span-12 lg:col-span-3 space-y-6",
    "work_area": "col-span-12 lg:col-span-9 flex flex-col gap-4"
  },
  "components": {
    "SOWSummaryHeader": {
      "path": "src/components/sow/SOWSummaryHeader.js",
      "description": "Bento-grid style metrics summary.",
      "structure": [
        {
          "label": "Total Value",
          "value": "$142,500",
          "trend": "+12% vs target",
          "icon": "DollarSign"
        },
        {
          "label": "Duration",
          "value": "14 Weeks",
          "sub": "Start: Oct 12",
          "icon": "CalendarClock"
        },
        {
          "label": "Effort",
          "value": "840 Hrs",
          "sub": "4 Consultants",
          "icon": "Users"
        },
        {
          "label": "Margin",
          "value": "32%",
          "trend": "Healthy",
          "icon": "TrendingUp",
          "highlight": true
        }
      ]
    },
    "TemplateSelector": {
      "path": "src/components/sow/TemplateSelector.js",
      "description": "Horizontal scroll or grid of template cards.",
      "style": "Card with 'group' hover state. Icon expands on hover.",
      "variants": ["Time & Materials", "Fixed Bid", "Retainer", "Managed Service"]
    },
    "EnhancedTable": {
      "path": "src/components/sow/SOWTable.js",
      "features": [
        "Draggable Rows (dnd-kit)",
        "Inline Edit Inputs",
        "Progress Bar column for 'Completion'",
        "Avatar group for 'Assignees'",
        "Status Badge"
      ],
      "row_style": "group hover:bg-zinc-50/50 transition-colors border-b border-zinc-100 last:border-0"
    },
    "GanttView": {
      "path": "src/components/sow/SOWGantt.js",
      "library": "frappe-gantt or react-gantt-timeline",
      "customization": "Override default blue/orange bars with Zinc (completed) and Striped Zinc (planned) patterns."
    }
  },
  "mock_data_structure": {
    "sow_items": [
      {
        "id": "item-1",
        "category": "Discovery",
        "task": "Stakeholder Interviews",
        "role": "Principal Consultant",
        "hours": 40,
        "rate": 250,
        "total": 10000,
        "start_date": "2024-10-12",
        "end_date": "2024-10-19",
        "status": "completed"
      },
      {
        "id": "item-2",
        "category": "Design",
        "task": "Solution Architecture Blueprint",
        "role": "Solution Architect",
        "hours": 80,
        "rate": 220,
        "total": 17600,
        "start_date": "2024-10-20",
        "end_date": "2024-11-03",
        "status": "in-progress"
      }
    ]
  },
  "universal_guidelines": [
    "Use 'Sonner' for all success/error toasts.",
    "No gradients. Use solid colors and borders.",
    "Input fields should be 'h-9' (compact) rather than 'h-10' default for density.",
    "Buttons should have 'shadow-sm' but no large drop shadows.",
    "All monetary values must be right-aligned in tables.",
    "Dates must be formatted as 'MMM dd, yyyy' (e.g., Oct 12, 2024).",
    "Interactive elements must have 'data-testid' attributes."
  ],
  "image_assets": {
    "user_avatars": [
      "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=facearea&facepad=2&w=256&h=256&q=80",
      "https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=facearea&facepad=2&w=256&h=256&q=80",
      "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=facearea&facepad=2&w=256&h=256&q=80"
    ]
  }
}